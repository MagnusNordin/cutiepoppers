---
layout: layouts/base.njk
pagination:
  data: categories
  size: 1
  alias: cat
  addAllPagesToCollections: true
permalink: "/kategori/{{ cat.slug }}/"
eleventyComputed:
  title: "{{ cat.title }} – 3D-printade, 50 kr"
  description: "{{ cat.intro }}"
  ogSlug: "kategori-{{ cat.slug }}"
  ogSource: "{{ (products | inCategory(cat.slug))[0].images[0].src }}"
---
{%- set list = products | inCategory(cat.slug) -%}
{%- set activeCategory = cat.slug -%}
{%- set crumbs = [{ name: "Start", url: "/" }, { name: cat.name, url: page.url }] -%}
<script type="application/ld+json">{{ crumbs | breadcrumbLd(site) | jsonLd | safe }}</script>
<script type="application/ld+json">{{ list | itemListLd(site, cat.title) | jsonLd | safe }}</script>
{% include "partials/breadcrumbs.njk" %}

<div class="container">
  <h1 class="display-title mt">{{ cat.title }}</h1>
  <p class="category-intro">{{ cat.intro }}</p>
</div>

<section id="shop" class="shop" aria-label="Motiv">
  <div class="container chips-wrap">{% include "partials/category-chips.njk" %}</div>
  <div class="container">
    <p class="shop__count">{{ cat.name }} · {{ list.length | motifs }}</p>
    <ul class="product-grid">
      {%- asyncEach p in list %}
      {%- set cardIndex = loop.index0 %}
      {%- set cardExtra = false %}
      {% include "partials/product-card.njk" %}
      {%- endeach %}
    </ul>
  </div>
</section>
