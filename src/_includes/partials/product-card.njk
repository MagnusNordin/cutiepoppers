{#- expects: p (product), cardIndex, cardExtra (bool), cardSizes -#}
<li class="product-card"{% if cardExtra %} data-grid-extra{% endif %}>
  <a class="product-card__link" href="/motiv/{{ p.slug }}/">
    <div class="product-card__media" style="--tint: {{ cardIndex | tint }}">
      {% productImage p.images[0].src, p.images[0].alt, { sizes: cardSizes or "(min-width: 1100px) 260px, (min-width: 720px) 30vw, 45vw", widths: [320, 480] } %}
      <span class="product-card__plus" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      </span>
    </div>
    <span class="product-card__name">{{ p.name }}</span>
    <span class="product-card__colors">
      {%- for d in dots.dots %}<span class="dot" style="--dot: {{ d.hex }}" aria-hidden="true"></span>{% endfor %}
      <span class="product-card__more">+{{ dots.more }} färger</span>
    </span>
  </a>
</li>
